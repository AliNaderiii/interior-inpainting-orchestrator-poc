INPAINT_PROVIDER=demo
MAX_UPLOAD_BYTES=10485760
MAX_PIXELS=20000000
MAX_PROMPT_CHARS=1000
REQUEST_TIMEOUT_SECONDS=60
PROVIDER_DEADLINE_SECONDS=120
# Bounded, in-memory v2 job manager. This is not a durable production queue.
JOB_MAX_RECORDS=32
JOB_MAX_CONCURRENCY=2
JOB_TTL_SECONDS=900
# Required only for INPAINT_PROVIDER=bfl. Never commit a real value.
BFL_API_KEY=
# Comma-separated exact approved hosts returned by the authorized BFL account/region.
BFL_RESULT_HOSTS=
